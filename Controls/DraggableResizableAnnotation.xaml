<UserControl x:Class="DicomAnnotationsDrawing.Controls.DraggableResizableAnnotation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Outline"
                CornerRadius="2"
                Background="{x:Null}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="LightYellow"/>
                    <Setter Property="BorderThickness" Value="5"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="Red"/>
                            <Setter Property="BorderThickness" Value="7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Thumb x:Name="MoveThumb"
               Cursor="SizeAll"
               Opacity="0"
               Background="Transparent"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <Thumb x:Name="TopLeftThumb"    Width="25" Height="25" Background="DarkRed" BorderBrush="DarkRed" BorderThickness="2"
               HorizontalAlignment="Left"   VerticalAlignment="Top"    Cursor="SizeNWSE"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
        <Thumb x:Name="TopRightThumb"   Width="25" Height="25" Background="DarkRed" BorderBrush="DarkRed" BorderThickness="2"
               HorizontalAlignment="Right"  VerticalAlignment="Top"    Cursor="SizeNESW"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
        <Thumb x:Name="BottomLeftThumb" Width="25" Height="25" Background="DarkRed" BorderBrush="DarkRed" BorderThickness="2"
               HorizontalAlignment="Left"   VerticalAlignment="Bottom" Cursor="SizeNESW"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
        <Thumb x:Name="BottomRightThumb" Width="25" Height="25" Background="DarkRed" BorderBrush="DarkRed" BorderThickness="2"
               HorizontalAlignment="Right"  VerticalAlignment="Bottom" Cursor="SizeNWSE"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>

        <Thumb x:Name="TopThumb"    Width="25" Height="25" Background="DarkRed" BorderBrush="DarkRed" BorderThickness="2"
               HorizontalAlignment="Center" VerticalAlignment="Top"    Cursor="SizeNS"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
        <Thumb x:Name="BottomThumb" Width="25" Height="25" Background="DarkRed" BorderBrush="DarkRed" BorderThickness="2"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="SizeNS"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
        <Thumb x:Name="LeftThumb"   Width="25" Height="25" Background="DarkRed" BorderBrush="DarkRed" BorderThickness="2"
               HorizontalAlignment="Left"   VerticalAlignment="Center" Cursor="SizeWE"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
        <Thumb x:Name="RightThumb"  Width="25" Height="25" Background="DarkRed" BorderBrush="DarkRed" BorderThickness="2"
               HorizontalAlignment="Right"  VerticalAlignment="Center" Cursor="SizeWE"
               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
