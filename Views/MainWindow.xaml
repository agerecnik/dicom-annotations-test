<Window x:Class="DicomAnnotationsDrawing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:viewModels="clr-namespace:DicomAnnotationsDrawing.ViewModels"
        xmlns:behaviors="clr-namespace:DicomAnnotationsDrawing.Behaviors"
        xmlns:controls="clr-namespace:DicomAnnotationsDrawing.Controls"
        xmlns:models="clr-namespace:DicomAnnotationsDrawing.Models"
        Title="DICOM Annotations" Height="700" Width="1000"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type models:Annotation}" x:Key="AnnotationItemTemplate">
            <controls:DraggableResizableAnnotation
                Width="{Binding Width}"
                Height="{Binding Height}"
                IsSelected="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>

        <Style TargetType="ContentPresenter" x:Key="CanvasItemContainerStyle">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top"  Value="{Binding Y}" />
            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Background="White" Height="40">
            <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="13">
                <Run Text="Selected: "/>
                <Run Text="{Binding Selected.DisplayText, Mode=OneWay}"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                <Button Content="Open DICOM" Margin="0,6,8,6" Padding="12,4"
                        Command="{Binding OpenDicomCommand}"/>
                <Button Content="Export SR" Margin="0,6,0,6" Padding="12,4"
                        Command="{Binding ExportSrCommand}"/>
            </StackPanel>
        </DockPanel>

        <Border x:Name="ImageHost" Grid.Row="1" Grid.Column="0" Background="DarkGray">
            <Viewbox Stretch="Uniform" StretchDirection="Both" SnapsToDevicePixels="True">
                <Grid x:Name="ImageAndCanvasContainer"
                      Width="{Binding CanvasWidth}"
                      Height="{Binding CanvasHeight}">
                    <Image Source="{Binding Image}"
                           Width="{Binding CanvasWidth}"
                           Height="{Binding CanvasHeight}" />

                    <ItemsControl ItemsSource="{Binding Annotations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="InteractionOverlay"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left"  Value="{Binding X}"/>
                                <Setter Property="Canvas.Top"   Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Annotation}">
                                <controls:DraggableResizableAnnotation
                                    X="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Y="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BoxWidth="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    BoxHeight="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                    SelectCommand="{Binding DataContext.SelectAnnotationCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Canvas x:Name="DrawingOverlay"
                            Width="{Binding CanvasWidth}"
                            Height="{Binding CanvasHeight}"
                            Background="Transparent"
                            IsHitTestVisible="False"/>
                    <i:Interaction.Behaviors>
                        <behaviors:DrawToAddAnnotationBehavior
                                    Items="{Binding Annotations}"
                                    Selected="{Binding Selected, Mode=TwoWay}"
                                    OverlayCanvas="{Binding ElementName=DrawingOverlay}"
                                    MinSize="8"
                                    AddAnnotationCommand="{Binding AddAnnotationCommand}" />
                    </i:Interaction.Behaviors>
                </Grid>
            </Viewbox>
        </Border>

        <DockPanel Grid.Row="1" Grid.Column="1" Background="Transparent">
            <TextBlock DockPanel.Dock="Top"
                       Text="Annotations"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Padding="12,10,12,6" />

            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="12,0,12,8">
                <Button Content="Delete"
                        Command="{Binding DeleteSelectedCommand}"
                        Margin="0,6,8,6"
                        Padding="12,4"/>
            </StackPanel>

            <ListBox Margin="12"
                     ItemsSource="{Binding Annotations}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     DisplayMemberPath="DisplayText"
                     Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Background="#11151D">
            <StatusBarItem>
                <TextBlock Foreground="#CCC">
                    <Run Text="Canvas: "/>
                    <Run Text="{Binding CanvasWidth}"/>
                    <Run Text=" × "/>
                    <Run Text="{Binding CanvasHeight}"/>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="#666" Text="Dicom Annotations"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
